{
  "expo": {
    "name": "Kongshaug Elevapp",
    "slug": "kongshaug-elevapp",
    "version": "1.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#1e3a5f",
    "icon": "./assets/icon.png",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "no.kongshaug.elevapp",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Appen bruker kamera til å skanne QR-koden til andakt, og til å ta bilder som dokumenterer øving i øvekonkurransen.",
        "NSLocationWhenInUseUsageDescription": "Appen bruker posisjon for å bekrefte at du er på skolen.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "no.kongshaug.elevapp",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#20303A"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "./plugins/withDeviceRestrictions.js",
      [
        "expo-camera",
        {
          "cameraPermission": "Appen bruker kamera til å skanne QR-koden til andakt, og til å ta bilder som dokumenterer øving i øvekonkurransen.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Appen bruker posisjon for å bekrefte at du er på skolen."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Appen bruker Face ID for å låse opp når du åpner den."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon-monochrome.png",
          "color": "#1e3a5f",
          "sounds": []
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "apiUrl": "https://elevapp.online",
      "eas": {
        "projectId": "316b5f66-d91b-46be-81e5-fb7b47b682ac"
      }
    },
    "owner": "mikalhageberg",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/316b5f66-d91b-46be-81e5-fb7b47b682ac"
    }
  }
}
